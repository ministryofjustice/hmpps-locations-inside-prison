{% from "govuk/components/tag/macro.njk" import govukTag %}

{% macro importStatusTag(status) %}
  {% if status == 'FINISHED' %}
    {{ govukTag({ text: "Complete", classes: "govuk-tag--green", attributes: { "data-qa": "import-status-tag" } }) }}
  {% elif status == 'STARTED' %}
    {{ govukTag({ text: "Processing", classes: "govuk-tag--blue", attributes: { "data-qa": "import-status-tag" } }) }}
  {% else %}
    {{ govukTag({ text: "Pending", classes: "govuk-tag--grey", attributes: { "data-qa": "import-status-tag" } }) }}
  {% endif %}
{% endmacro %}

{# A cell added to the certificate from outside the file links to its location, so the reviewer can check it. #}
{% macro importLocationKey(row) %}{% if row.url %}<a class="govuk-link" href="{{ row.url }}">{{ row.locationKey }}</a>{% else %}{{ row.locationKey }}{% endif %}{% endmacro %}

{% macro importLocationNeedsReviewTag() %}
  {{ govukTag({ text: "Needs review", classes: "govuk-tag--blue", attributes: { "data-qa": "location-needs-review-tag" } }) }}
{% endmacro %}

{% macro importLocationStatusTag(status) %}
  {% if status == 'PROCESSED' %}
    {{ govukTag({ text: "Processed", classes: "govuk-tag--green", attributes: { "data-qa": "location-status-tag" } }) }}
  {% elif status == 'SKIPPED' %}
    {{ govukTag({ text: "Skipped", classes: "govuk-tag--grey", attributes: { "data-qa": "location-status-tag" } }) }}
  {% elif status == 'FAILED' %}
    {{ govukTag({ text: "Failed", classes: "govuk-tag--red", attributes: { "data-qa": "location-status-tag" } }) }}
  {% elif status == 'NOT_ON_FILE' %}
    {{ govukTag({ text: "Added to certificate", classes: "govuk-tag--orange", attributes: { "data-qa": "location-status-tag" } }) }}
  {% else %}
    {{ govukTag({ text: "Pending", classes: "govuk-tag--grey", attributes: { "data-qa": "location-status-tag" } }) }}
  {% endif %}
{% endmacro %}
