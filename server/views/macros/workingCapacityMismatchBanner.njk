{% from "moj/components/alert/macro.njk" import mojAlert %}

{% macro workingCapacityMismatchBanner(decoratedResidentialSummary, paths) %}
  {{ mojAlert({
    attributes: {
      'data-qa': 'working-capacity-mismatch-banner'
    },
    variant: "information",
    title: "Check cell’s working capacity",
    showTitleAsHeading: true,
    dismissible: false,
    html: "The cell’s working capacity does not match the cell certificate. <a href='" +
      paths.location.workingCapacityMismatch(decoratedResidentialSummary.location) + "'>Review working capacity</a>"
  }) }}
{% endmacro %}
