{% extends "../../../partials/layout.njk" %}

{% from '../../../macros/certificationApprovalRequest.njk' import certificationApprovalRequest %}
{% from '../../../macros/certificationApprovalRequestSummary.njk' import certificationApprovalRequestSummary %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "moj/components/alert/macro.njk" import mojAlert %}
{% from '../../../macros/cellCertificateUploadStatusTag.njk' import uploadLocationStatusTag %}

{% block content %}
  <div class="govuk-width-container">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        {% if approvalRequest.status == 'PENDING' %}
          <p>
            This request is being reviewed by the establishment’s authorising director. If approved, the cell certificate
            will be updated with this change.
          </p>

          <p>
            You are unable to make changes to this location while the request is being reviewed. You can withdraw the
            request if you need to make changes.
          </p>
        {% endif %}

        {{ certificationApprovalRequestSummary(approvalRequest, userMap, locationMap, constants, canAccess('certificate_change_request_withdraw'), true) }}
      </div>
    </div>

    {{ certificationApprovalRequest(approvalRequest, false, 0, false, constants, locationMap, null, location) }}

    {% if ingestion %}
      {# A capacity the location kept while the certificate took a different value is shown with both. #}
      {% macro capacityCellHtml(capacity) %}{{ capacity.text }}{% if capacity.certifiedText %}<br><span class="govuk-hint govuk-!-margin-bottom-0">Certified {{ capacity.certifiedText }}</span>{% endif %}{% endmacro %}

      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          <h2 class="govuk-heading-m">Import results</h2>

          {{ govukSummaryList({
            attributes: { "data-qa": "ingestion-summary" },
            rows: [
              { key: { text: "Cells in the import" }, value: { text: ingestion.upload.totalRecords } },
              { key: { text: "Updated" }, value: { text: ingestion.upload.processedRecords } },
              { key: { text: "Unchanged" }, value: { text: ingestion.upload.skippedRecords } },
              { key: { text: "Failed" }, value: { text: ingestion.upload.failedRecords } },
              { key: { text: "Needing review" }, value: { text: ingestion.upload.discrepancyRecords or 0 } }
            ]
          }) }}

          {% if ingestion.upload.discrepancyRecords %}
            {{ mojAlert({
              attributes: { "data-qa": "ingestion-needs-review-alert" },
              variant: "information",
              title: "Check these cells’ working capacities",
              showTitleAsHeading: true,
              dismissible: false,
              text: ingestion.upload.discrepancyRecords + " cell(s) kept the working capacity Residential locations already held. The cell certificate records the value from the imported file, so the two do not match until someone reviews them."
            }) }}
          {% endif %}
        </div>
      </div>

      {% if ingestion.rows.length %}
        {% set rows = [] %}
        {% for row in ingestion.rows %}
          {% set rows = (rows.push([
            { text: row.locationKey },
            { html: uploadLocationStatusTag(row.status) },
            { html: capacityCellHtml(row.maxCapacity) },
            { html: capacityCellHtml(row.workingCapacity) },
            { html: capacityCellHtml(row.certifiedNormalAccommodation) },
            { text: row.message or "" }
          ]), rows) %}
        {% endfor %}

        {{ govukTable({
          attributes: { "data-qa": "ingestion-results-table" },
          caption: "Cells needing review",
          captionClasses: "govuk-table__caption--m",
          head: [
            { text: "Location" },
            { text: "Result" },
            { text: "Max capacity" },
            { text: "Working capacity" },
            { text: "CNA" },
            { text: "Details" }
          ],
          rows: rows
        }) }}
      {% else %}
        <p class="govuk-body" data-qa="ingestion-no-review-needed">No cells from this import need reviewing.</p>
      {% endif %}

      {# The full report lives behind the ingestion pages, which only the roles that can run an import may
         reach - following this link without that permission would sign the user out. #}
      {% if canAccess('cell_certificate_upload') %}
        <p class="govuk-body">
          <a class="govuk-link" href="{{ ingestion.reportUrl }}" data-qa="ingestion-full-report-link">View the full import report</a>
        </p>
      {% endif %}
    {% endif %}
  </div>
{% endblock %}
