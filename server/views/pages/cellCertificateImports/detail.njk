{% extends "../../partials/layout.njk" %}

{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "moj/components/alert/macro.njk" import mojAlert %}
{% from "../../macros/cellCertificateImportStatusTag.njk" import importStatusTag, importLocationStatusTag, importLocationNeedsReviewTag %}

{% block head %}
  {{ super() }}
  {% if inProgress %}
    <script nonce="{{ cspNonce }}">setTimeout(function () { window.location.reload() }, 5000)</script>
  {% endif %}
{% endblock %}

{% block content %}
  {# A capacity the location kept while the certificate took a different value is shown with both. #}
  {% macro capacityCellHtml(capacity) %}{{ capacity.text }}{% if capacity.certifiedText %}<br><span class="govuk-hint govuk-!-margin-bottom-0">Certified {{ capacity.certifiedText }}</span>{% endif %}{% endmacro %}

  <div class="govuk-width-container">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-full">

        {% if inProgress %}
          {{ govukInsetText({
            text: "This cell certificate is still being processed. This page updates automatically.",
            attributes: { "data-qa": "in-progress-message" }
          }) }}
          <p class="govuk-body">
            <a class="govuk-link" href="{{ listUrl }}/import/{{ certificateImport.id }}" data-qa="refresh-link">Refresh</a>
          </p>
        {% endif %}

        {{ govukSummaryList({
          attributes: { "data-qa": "import-summary" },
          rows: [
            { key: { text: "Status" }, value: { html: importStatusTag(certificateImport.status) } },
            { key: { text: "Requested by" }, value: { text: certificateImport.requestedBy } },
            { key: { text: "Requested" }, value: { text: certificateImport.requestedDate | formatDateWithTime } },
            { key: { text: "Started" }, value: { text: (certificateImport.startTime | formatDateWithTime) if certificateImport.startTime else "-" } },
            { key: { text: "Completed" }, value: { text: (certificateImport.endTime | formatDateWithTime) if certificateImport.endTime else "-" } },
            { key: { text: "Total records" }, value: { text: certificateImport.totalRecords } },
            { key: { text: "Processed" }, value: { text: certificateImport.processedRecords } },
            { key: { text: "Skipped" }, value: { text: certificateImport.skippedRecords } },
            { key: { text: "Failed" }, value: { text: certificateImport.failedRecords } },
            { key: { text: "Cells needing review" }, value: { text: certificateImport.discrepancyRecords or 0 } }
          ]
        }) }}

        {% if not inProgress and certificateImport.discrepancyRecords %}
          {{ mojAlert({
            attributes: { "data-qa": "needs-review-alert" },
            variant: "information",
            title: "Check these cells’ working capacities",
            showTitleAsHeading: true,
            dismissible: false,
            text: certificateImport.discrepancyRecords + " cell(s) kept the working capacity Residential locations already held. The cell certificate records the value from the uploaded file, so the two do not match until someone reviews them."
          }) }}
        {% endif %}

        {% if cellCertificateUrl %}
          <p class="govuk-body">
            <a class="govuk-link" href="{{ cellCertificateUrl }}" data-qa="cell-certificate-link">View the cell certificate</a>
          </p>
        {% endif %}

        <h2 class="govuk-heading-m">Cells</h2>
        {% if locationRows.length %}
          {% set rows = [] %}
          {% for location in locationRows %}
            {% set rows = (rows.push([
              { text: location.locationKey },
              { html: importLocationStatusTag(location.status) + (importLocationNeedsReviewTag() if location.needsReview else "") },
              { html: capacityCellHtml(location.maxCapacity) },
              { html: capacityCellHtml(location.workingCapacity) },
              { html: capacityCellHtml(location.certifiedNormalAccommodation) },
              { text: location.message or "" }
            ]), rows) %}
          {% endfor %}

          {{ govukTable({
            attributes: { "data-qa": "locations-table" },
            head: [
              { text: "Location" },
              { text: "Result" },
              { text: "Max capacity" },
              { text: "Working capacity" },
              { text: "CNA" },
              { text: "Details" }
            ],
            rows: rows
          }) }}
        {% else %}
          <p class="govuk-body" data-qa="no-locations">No cell results are available for this import.</p>
        {% endif %}

      </div>
    </div>
  </div>
{% endblock %}
