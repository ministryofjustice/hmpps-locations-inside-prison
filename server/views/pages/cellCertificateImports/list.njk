{% extends "../../partials/layout.njk" %}

{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "../../macros/cellCertificateImportStatusTag.njk" import importStatusTag %}

{% block head %}
  {{ super() }}
  {% if hasInProgress %}
    <script nonce="{{ cspNonce }}">setTimeout(function () { window.location.reload() }, 5000)</script>
  {% endif %}
{% endblock %}

{% block content %}
  <div class="govuk-width-container">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-full">

        {% if hasInProgress %}
          {{ govukInsetText({
            text: "A cell certificate import is in progress. You can import a new certificate once it has finished. This page updates automatically.",
            attributes: { "data-qa": "in-progress-message" }
          }) }}
          <p class="govuk-body">
            <a class="govuk-link" href="{{ listUrl }}" data-qa="refresh-link">Refresh</a>
          </p>
        {% else %}
          {{ govukButton({
            text: "Import a cell certificate",
            href: newImportUrl,
            attributes: { "data-qa": "import-new-button" }
          }) }}
        {% endif %}

        {% if imports.length %}
          {% set rows = [] %}
          {% for certificateImport in imports %}
            {% set rows = (rows.push([
              { html: "<a class='govuk-link' href='" + listUrl + "/import/" + certificateImport.id + "'>" + (certificateImport.requestedDate | formatDateWithTime) + "</a>" },
              { html: importStatusTag(certificateImport.status) },
              { text: (certificateImport.startTime | formatDateWithTime) if certificateImport.startTime else "-" },
              { text: (certificateImport.endTime | formatDateWithTime) if certificateImport.endTime else "-" },
              { text: certificateImport.totalRecords, format: "numeric" },
              { text: certificateImport.processedRecords, format: "numeric" },
              { text: certificateImport.skippedRecords, format: "numeric" },
              { text: certificateImport.failedRecords, format: "numeric" }
            ]), rows) %}
          {% endfor %}

          {{ govukTable({
            attributes: { "data-qa": "imports-table" },
            head: [
              { text: "Requested" },
              { text: "Status" },
              { text: "Started" },
              { text: "Completed" },
              { text: "Total records", format: "numeric" },
              { text: "Processed", format: "numeric" },
              { text: "Skipped", format: "numeric" },
              { text: "Failed", format: "numeric" }
            ],
            rows: rows
          }) }}
        {% else %}
          <p class="govuk-body" data-qa="no-imports">No cell certificates have been imported for this establishment.</p>
        {% endif %}

      </div>
    </div>
  </div>
{% endblock %}
