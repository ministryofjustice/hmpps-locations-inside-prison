{% extends "../../partials/formStep.njk" %}

{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "moj/components/ticket-panel/macro.njk" import mojTicketPanel %}

{% block heading %}
  {{ super() }}

  <h2 class="govuk-heading-m govuk-!-margin-top-6 govuk-!-margin-bottom-0">
    Enter cell capacities and type
  </h2>
{% endblock %}

{% macro capacityTable(decoratedCell) %}
  {% set rows = [] %}
  {% set cell = decoratedCell.raw %}
  {% set modifiedCell = modifiedLocationMap[cell.id] %}
  {% set cellTypesText = formatConstants(constants.specialistCellTypes, modifiedCell.specialistCellTypes) %}

  {% if modifiedCell.specialistCellTypes and modifiedCell.specialistCellTypes.length %}
    {% set cellTypeColumn =
      {  html:
        '<div data-qa="cell-types-' + cell.id + '" class="change-remove-container">' +
        cellTypesText +
        '<div class="change-remove-actions">' +
        '<button type="submit" class="govuk-link govuk-link--no-visited-state" name="cellTypeAction" value="remove">Remove</button>' + '  |  ' +
        '<button type="submit" class="govuk-link govuk-link--no-visited-state" name="cellTypeAction" value="set">Change</button>' + '</div>' + '</div>'

      }
    %}
  {% else %}
    {% set cellTypeColumn = {
      html:
      '<div data-qa="cell-types-' + cell.id + '">' +
      '<button type="submit" class="govuk-link govuk-link--no-visited-state" name="cellTypeAction" value="set">Add</button>' +
      '</div>'
    }
    %}
  {% endif %}

  {% set rows = (rows.push(
    [
      { text: cell.pathHierarchy, classes: 'govuk-table__cell' },
      {
        html: callAsMacro(fields.CERT_baselineCna.component)(fields.CERT_baselineCna)
      },
      {
        html: callAsMacro(fields.CERT_workingCapacity.component)(fields.CERT_workingCapacity)
      },
      {
        html: callAsMacro(fields.CERT_maximumCapacity.component)(fields.CERT_maximumCapacity)
      },
      cellTypeColumn
    ]
  ), rows) %}

  {{ govukTable({
    attributes: {
      "data-qa": "edit-capacity-table"
    },
    firstCellIsHeader: true,
    head: [
      { text: "Location" },
      { text: "Baseline CNA" },
      { text: "Working capacity" },
      { text: "Maximum capacity" },
      { text: "Cell type (optional)" }
    ],
    rows: rows
  }) }}
{% endmacro %}

{% set detailHtml %}
  {% include "../../partials/cellCapacityDefinitions.njk" %}
{% endset %}

{% block fields %}
  {{ govukDetails({
    summaryText: "What the different types of cell capacity mean",
    html: detailHtml,
    classes: 'govuk-!-margin-top-3 capacity-hint'
  }) }}

  {{ capacityTable(decoratedLocation) }}
{% endblock %}
