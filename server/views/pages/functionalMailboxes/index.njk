{% extends "../../partials/layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% set minLayout = 'full' %}

{% block content %}
  <div class="govuk-width-container">
    <section class="govuk-!-margin-bottom-9">
      <h2 class="govuk-heading-m">Default functional mailboxes</h2>
      <p class="govuk-body">Default mailboxes are used when a prison-specific mailbox has not been set.</p>
      {{ govukButton({ text: "Add default mailbox", href: paths.functionalMailboxes.default.add }) }}

      {% set defaultRows = [] %}
      {% for mailbox in defaultMailboxes %}
        {% set emailHtml %}
          <ul class="govuk-list govuk-!-margin-bottom-0">
            {% for email in mailbox.emailAddresses %}<li>{{ email }}</li>{% endfor %}
          </ul>
        {% endset %}
        {% set actionHtml %}
          <ul class="govuk-summary-list__actions-list">
            <li class="govuk-summary-list__actions-list-item"><a class="govuk-link" href="{{ paths.functionalMailboxes.default.edit(mailbox.notificationGroup) }}">Edit<span class="govuk-visually-hidden"> {{ mailbox.role | lower }} default mailbox</span></a></li>
            <li class="govuk-summary-list__actions-list-item"><a class="govuk-link" href="{{ paths.functionalMailboxes.default.delete(mailbox.notificationGroup) }}">Delete<span class="govuk-visually-hidden"> {{ mailbox.role | lower }} default mailbox</span></a></li>
          </ul>
        {% endset %}
        {% set defaultRows = (defaultRows.push([{ text: mailbox.role }, { html: emailHtml }, { html: actionHtml }]), defaultRows) %}
      {% endfor %}

      {% if defaultMailboxes.length %}
        <div class="app-table-scroll" role="region" aria-label="Default functional mailboxes" tabindex="0">
          {{ govukTable({
            attributes: { "data-qa": "default-mailboxes-table" },
            head: [{ text: "Role" }, { text: "Email addresses" }, { text: "Actions" }],
            rows: defaultRows
          }) }}
        </div>
      {% else %}
        <p class="govuk-body">There are no default functional mailboxes.</p>
      {% endif %}
    </section>

    <section>
      <h2 class="govuk-heading-m">Prison-specific functional mailboxes</h2>
      <p class="govuk-body">Prison-specific mailboxes are used instead of the default mailbox for that prison and role.</p>
      {{ govukButton({ text: "Add prison-specific mailbox", href: paths.functionalMailboxes.prison.add }) }}

      {% set prisonRows = [] %}
      {% for mailbox in prisonMailboxes %}
        {% set emailHtml %}
          <ul class="govuk-list govuk-!-margin-bottom-0">
            {% for email in mailbox.emailAddresses %}<li>{{ email }}</li>{% endfor %}
          </ul>
        {% endset %}
        {% set actionHtml %}
          <ul class="govuk-summary-list__actions-list">
            <li class="govuk-summary-list__actions-list-item"><a class="govuk-link" href="{{ paths.functionalMailboxes.prison.edit(mailbox.prisonId, mailbox.notificationGroup) }}">Edit<span class="govuk-visually-hidden"> {{ mailbox.role | lower }} mailbox for {{ mailbox.prisonName }}</span></a></li>
            <li class="govuk-summary-list__actions-list-item"><a class="govuk-link" href="{{ paths.functionalMailboxes.prison.delete(mailbox.prisonId, mailbox.notificationGroup) }}">Delete<span class="govuk-visually-hidden"> {{ mailbox.role | lower }} mailbox for {{ mailbox.prisonName }}</span></a></li>
          </ul>
        {% endset %}
        {% set prisonRows = (prisonRows.push([{ text: mailbox.prisonName }, { text: mailbox.role }, { html: emailHtml }, { html: actionHtml }]), prisonRows) %}
      {% endfor %}

      {% if prisonMailboxes.length %}
        <div class="app-table-scroll" role="region" aria-label="Prison-specific functional mailboxes" tabindex="0">
          {{ govukTable({
            attributes: { "data-qa": "prison-mailboxes-table" },
            head: [{ text: "Prison" }, { text: "Role" }, { text: "Email addresses" }, { text: "Actions" }],
            rows: prisonRows
          }) }}
        </div>
      {% else %}
        <p class="govuk-body">There are no prison-specific functional mailboxes.</p>
      {% endif %}
    </section>
  </div>
{% endblock %}
